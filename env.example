# Copy this file to ".env" in the same folder and fill it in. NEVER commit, zip-share or upload ".env".
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
LITEBANS_PREFIX=litebans_
# Same name as console_sender_name in LiteBans config.yml
CONSOLE_NAME=Console

# Only needed for the optional Cloudflare backend mode (not for GitHub Pages)
SITE_URL=
SYNC_TOKEN=

# Optional: only if you have a table that really stores playtime (LiteBans does not). Leave empty to show "Not tracked".
PLAYTIME_TABLE=
PLAYTIME_UUID_COL=uuid
PLAYTIME_SECONDS_COL=seconds
